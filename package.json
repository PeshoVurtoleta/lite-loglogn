{
  "name": "@zakkster/lite-loglogn",
  "author": "Zahary Shinikchiev <shinikchiev@yahoo.com>",
  "version": "0.2.0",
  "description": "Zero-dependency, zero-GC sub-logarithmic bounded-integer predecessor/successor structures. StratifiedBitset: array-embedded 32-ary bit pyramid, O(log_32 U) successor/predecessor, O(U/w) space. XFastTrie: O(log log U) successor/predecessor, O(w) updates, O(n*w) space at a fixed capacity. 0 B/op, bounds gated by exact counts. YFastTrie and vEBTree (O(log log U) family bound) are planned. Tree-shakeable named exports.",
  "type": "module",
  "main": "./LogLogN.js",
  "module": "./LogLogN.js",
  "types": "./LogLogN.d.ts",
  "exports": {
    ".": {
      "types": "./LogLogN.d.ts",
      "node": "./LogLogN.js",
      "import": "./LogLogN.js",
      "default": "./LogLogN.js"
    }
  },
  "files": [
    "LogLogN.js",
    "LogLogN.d.ts",
    "llms.txt",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --test test/*.test.js test/Bench.test.mjs",
    "test:types": "tsc -p test/types/tsconfig.json",
    "test:big": "node test/big/run.mjs",
    "torture": "node --expose-gc test/torture.mjs",
    "witness": "node test/witness.mjs",
    "witness:w32": "node test/witness.mjs --w32",
    "witness:tier": "node test/witness.mjs --tier",
    "witness:xft": "node test/witness.mjs --xft",
    "test:perf": "node --expose-gc --max-semi-space-size=4 --test-concurrency=1 --test test/perf/*.test.mjs",
    "verify": "npm test && npm run test:types && npm run torture && npm run test:perf"
  },
  "keywords": [
    "van-emde-boas",
    "veb",
    "x-fast-trie",
    "y-fast-trie",
    "stratified-bitset",
    "predecessor",
    "successor",
    "predecessor-search",
    "bounded-integer",
    "word-ram",
    "integer-set",
    "ordered-set",
    "log-log-n",
    "log-log-u",
    "sub-logarithmic",
    "clz32",
    "bitset",
    "data-structures",
    "zero-gc",
    "gc",
    "typed-array",
    "soa",
    "tree-shakeable",
    "witness",
    "performance",
    "lightweight",
    "zero-dependency"
  ],
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@zakkster/lite-adaptive": "^1.12.0",
    "@zakkster/lite-fastbit32": "^1.5.0",
    "@zakkster/lite-gc-profiler": "^1.16.0",
    "@zakkster/lite-leak": "^1.10.0",
    "@zakkster/lite-logn": "^1.5.1",
    "@zakkster/lite-o1": "^1.11.3",
    "@zakkster/lite-perf-gate": "^1.4.2",
    "@zakkster/lite-sketch": "^1.2.0",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2"
  },
  "homepage": "https://github.com/PeshoVurtoleta/lite-loglogn#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/PeshoVurtoleta/lite-loglogn.git"
  },
  "bugs": {
    "url": "https://github.com/PeshoVurtoleta/lite-loglogn/issues",
    "email": "shinikchiev@yahoo.com"
  },
  "engines": {
    "node": ">=18"
  },
  "funding": {
    "type": "github",
    "url": "https://github.com/sponsors/PeshoVurtoleta"
  },
  "sideEffects": false
}
