/node_modules
/package-lock.json

# generated benchmark artifacts (machine/time-specific; benchmark/ lands with the Bench-ADOPT session)
/benchmark/results.json
/benchmark/report.html

# burst handoff (session state, never shipped)
/.handoff/

# a SIGKILLed XftWitness / YftWitness run leaves its mutant copy behind
/test/_xftw-mutant-*
/test/_yftw-mutant-*
